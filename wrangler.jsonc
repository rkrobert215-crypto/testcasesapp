{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testcasesapp",
  "main": "cloud/cloudflare/worker.js",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
